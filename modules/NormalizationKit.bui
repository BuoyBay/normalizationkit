''' Unicode data version used by every form, independently of the host OS.
Public Function NormalizationUnicodeVersion() As String
    Return "18.0.0"
End Function

Private Class UnicodeNormalizationData
' BEGIN GENERATED UNICODE TABLES
' Unicode 18.0.0; generated by tools/generate_normalization_tables.py.
' Derived Unicode data is distributed under resources/unicode-LICENSE.txt.
    Private Shared Property mIndex As Bytes = Bytes.FromBase64("").Value
    Private Shared Property mPayload As Bytes = Bytes.FromBase64("").Value
    Private Shared Property mCombining As Bytes = Bytes.FromBase64("").Value
    Private Shared Property mCompositions As Bytes = Bytes.FromBase64("").Value
' END GENERATED UNICODE TABLES

    Private Shared Function Read32(data As Bytes, offset As Integer) As Integer
        Return data.Item(offset) + data.Item(offset + 1) * 256 + data.Item(offset + 2) * 65536 + data.Item(offset + 3) * 16777216
    End Function

    Public Shared Function CombiningClass(scalar As Integer) As Integer
        Dim low As Integer = 0
        Dim high As Integer = mCombining.Count \ 5 - 1
        While low <= high
            Dim middle As Integer = (low + high) \ 2
            Dim key As Integer = UnicodeNormalizationData.Read32(mCombining, middle * 5)
            If scalar = key Then Return mCombining.Item(middle * 5 + 4)
            If scalar < key Then
                high = middle - 1
            Else
                low = middle + 1
            End If
        End While
        Return 0
    End Function

    Public Shared Sub Decompose(scalar As Integer, compatibility As Boolean, output As Array Of Integer, limit As Integer)
        ' Hangul syllables are decomposed algorithmically, without stored entries.
        If scalar >= 44032 And scalar < 55204 Then
            Dim syllable As Integer = scalar - 44032
            UnicodeNormalizationData.AppendBounded(output, 4352 + syllable \ 588, limit)
            UnicodeNormalizationData.AppendBounded(output, 4449 + (syllable Mod 588) \ 28, limit)
            If syllable Mod 28 <> 0 Then UnicodeNormalizationData.AppendBounded(output, 4519 + syllable Mod 28, limit)
            Exit Sub
        End If
        Dim low As Integer = 0
        Dim high As Integer = mIndex.Count \ 14 - 1
        While low <= high
            Dim middle As Integer = (low + high) \ 2
            Dim record As Integer = middle * 14
            Dim key As Integer = UnicodeNormalizationData.Read32(mIndex, record)
            If scalar = key Then
                Dim field As Integer = record + 4
                If compatibility Then field = field + 5
                Dim offset As Integer = UnicodeNormalizationData.Read32(mIndex, field)
                Dim length As Integer = mIndex.Item(field + 4)
                If length = 0 Then
                    UnicodeNormalizationData.AppendBounded(output, scalar, limit)
                Else
                    For i As Integer = 0 To length - 1
                        UnicodeNormalizationData.AppendBounded(output, UnicodeNormalizationData.Read32(mPayload, offset + i * 4), limit)
                    Next
                End If
                Exit Sub
            End If
            If scalar < key Then
                high = middle - 1
            Else
                low = middle + 1
            End If
        End While
        UnicodeNormalizationData.AppendBounded(output, scalar, limit)
    End Sub

    Private Shared Sub AppendBounded(output As Array Of Integer, scalar As Integer, limit As Integer)
        If Array.Count(output) >= limit Then Throw New InvalidArgumentException("Normalization decomposition exceeds maxScalars")
        Array.Append(output, scalar)
    End Sub

    Public Shared Function Compose(first As Integer, second As Integer) As Integer
        ' L + V -> LV, and LV + T -> LVT.
        If first >= 4352 And first < 4371 And second >= 4449 And second < 4470 Then
            Return 44032 + (first - 4352) * 588 + (second - 4449) * 28
        End If
        If first >= 44032 And first < 55204 And (first - 44032) Mod 28 = 0 And second > 4519 And second < 4547 Then
            Return first + second - 4519
        End If
        Dim wanted As Integer = first * 2097152 + second
        Dim low As Integer = 0
        Dim high As Integer = mCompositions.Count \ 12 - 1
        While low <= high
            Dim middle As Integer = (low + high) \ 2
            Dim offset As Integer = middle * 12
            Dim key As Integer = UnicodeNormalizationData.Read32(mCompositions, offset) * 2097152 + UnicodeNormalizationData.Read32(mCompositions, offset + 4)
            If wanted = key Then Return UnicodeNormalizationData.Read32(mCompositions, offset + 8)
            If wanted < key Then
                high = middle - 1
            Else
                low = middle + 1
            End If
        End While
        Return -1
    End Function
End Class

Private Sub OrderCombiningMarks(scalars As Array Of Integer)
    ' Stable counting sort within each nonstarter run avoids quadratic insertion.
    Dim classes() As Integer
    For Each scalar As Integer In scalars
        Array.Append(classes, UnicodeNormalizationData.CombiningClass(scalar))
    Next
    Dim start As Integer = 0
    While start < Array.Count(scalars)
        If classes(start) = 0 Then
            start += 1
            Continue While
        End If
        Dim finish As Integer = start + 1
        While finish < Array.Count(scalars)
            If classes(finish) = 0 Then Exit While
            finish += 1
        End While
        If finish - start > 1 Then
            Dim counts(256) As Integer
            For i As Integer = start To finish - 1
                counts(classes(i)) += 1
            Next
            Dim position As Integer = 0
            For i As Integer = 1 To 255
                Dim count As Integer = counts(i)
                counts(i) = position
                position += count
            Next
            Dim sorted() As Integer
            Array.ResizeTo(sorted, finish - start)
            For i As Integer = start To finish - 1
                Dim kind As Integer = classes(i)
                sorted(counts(kind)) = scalars(i)
                counts(kind) += 1
            Next
            For i As Integer = start To finish - 1
                scalars(i) = sorted(i - start)
            Next
        End If
        start = finish
    End While
End Sub

Private Function NormalizeText(text As String, compatibility As Boolean, compose As Boolean, maxScalars As Integer) As String
    If maxScalars < 0 Then Throw New InvalidArgumentException("maxScalars must be nonnegative")
    If String.Len(text) > maxScalars Then Throw New InvalidArgumentException("Normalization input exceeds maxScalars")
    Dim scalars() As Integer
    For Each character As String In String.Chars(text)
        UnicodeNormalizationData.Decompose(String.Asc(character), compatibility, scalars, maxScalars)
    Next
    OrderCombiningMarks(scalars)
    Dim output() As Integer
    Dim starter As Integer = -1
    Dim previousClass As Integer = 0
    For Each scalar As Integer In scalars
        Dim kind As Integer = UnicodeNormalizationData.CombiningClass(scalar)
        Dim combined As Integer = -1
        If compose And starter >= 0 And (previousClass = 0 Or previousClass < kind) Then
            combined = UnicodeNormalizationData.Compose(output(starter), scalar)
        End If
        If combined >= 0 Then
            output(starter) = combined
        Else
            If kind = 0 Then starter = Array.Count(output)
            Array.Append(output, scalar)
            previousClass = kind
        End If
    Next
    Dim characters() As String
    For Each scalar As Integer In output
        Array.Append(characters, String.Chr(scalar))
    Next
    Return String.Join(characters, "")
End Function

''' Canonical decomposition followed by canonical composition (Unicode 18.0.0).
Public Function NormalizeNFC(text As String, maxScalars As Integer = 1000000) As String
    Return NormalizeText(text, False, True, maxScalars)
End Function

''' Canonical decomposition (Unicode 18.0.0).
Public Function NormalizeNFD(text As String, maxScalars As Integer = 1000000) As String
    Return NormalizeText(text, False, False, maxScalars)
End Function

''' Compatibility decomposition followed by canonical composition (Unicode 18.0.0).
Public Function NormalizeNFKC(text As String, maxScalars As Integer = 1000000) As String
    Return NormalizeText(text, True, True, maxScalars)
End Function

''' Compatibility decomposition (Unicode 18.0.0).
Public Function NormalizeNFKD(text As String, maxScalars As Integer = 1000000) As String
    Return NormalizeText(text, True, False, maxScalars)
End Function
